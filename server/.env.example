# Bot that delivers screenshots/clips (from @BotFather)
BOT_TOKEN=123456:ABC-DEF
# Optional: a SEPARATE bot for /status, /stats, pause/resume with buttons.
# Leave empty to disable commands. Must not be shared with another service that polls/webhooks.
